{
  "cells": [
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "from PIL import Image\n",
        "from io import BytesIO\n",
        "from azure.storage.blob import BlobServiceClient\n",
        "from tqdm import tqdm\n",
        "\n",
        "# Config\n",
        "STORAGE_ACCOUNT = \"solarflarestorageproject\"\n",
        "STORAGE_KEY = \"os.environ.get("AZURE_STORAGE_KEY")\"\n",
        "RAW_CONTAINER = \"raw\"\n",
        "PROC_CONTAINER = \"processed\"\n",
        "IMAGE_SIZE = (224, 224)\n",
        "\n",
        "print(\"Config loaded!\")"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "Config loaded!\n"
        }
      ],
      "execution_count": 1,
      "metadata": {
        "gather": {
          "logged": 1774188193926
        }
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Connect to both containers\n",
        "raw_client = BlobServiceClient(\n",
        "    account_url=f\"https://{STORAGE_ACCOUNT}.blob.core.windows.net\",\n",
        "    credential=STORAGE_KEY\n",
        ").get_container_client(RAW_CONTAINER)\n",
        "\n",
        "proc_client = BlobServiceClient(\n",
        "    account_url=f\"https://{STORAGE_ACCOUNT}.blob.core.windows.net\",\n",
        "    credential=STORAGE_KEY\n",
        ").get_container_client(PROC_CONTAINER)\n",
        "\n",
        "# Check how many blobs are in raw\n",
        "blobs = list(raw_client.list_blobs())\n",
        "print(f\"Connected! Found {len(blobs)} blobs in raw container.\")"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "Connected! Found 0 blobs in raw container.\n"
        }
      ],
      "execution_count": 2,
      "metadata": {
        "gather": {
          "logged": 1774188194012
        }
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def parse_label(blob_name):\n",
        "    \"\"\"Extract flare class from filename.\"\"\"\n",
        "    filename = blob_name.split(\"/\")[-1]\n",
        "    for cls in [\"X\", \"M\", \"C\", \"B\"]:\n",
        "        if filename.startswith(cls):\n",
        "            return cls\n",
        "    return \"N\"  # no flare\n",
        "\n",
        "def validate_image(img, filename):\n",
        "    \"\"\"Run quality checks on a single image.\"\"\"\n",
        "    arr = np.array(img)\n",
        "    return {\n",
        "        \"filename\":   filename,\n",
        "        \"label\":      parse_label(filename),\n",
        "        \"width\":      img.width,\n",
        "        \"height\":     img.height,\n",
        "        \"mode\":       img.mode,\n",
        "        \"is_blank\":   bool(arr.std() < 1e-5),\n",
        "        \"min_pixel\":  float(arr.min()),\n",
        "        \"max_pixel\":  float(arr.max()),\n",
        "        \"mean_pixel\": float(arr.mean()),\n",
        "        \"std_pixel\":  float(arr.std()),\n",
        "        \"valid\":      img.size == IMAGE_SIZE and arr.std() >= 1e-5\n",
        "    }\n",
        "\n",
        "print(\"Functions defined!\")"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "Functions defined!\n"
        }
      ],
      "execution_count": 3,
      "metadata": {
        "gather": {
          "logged": 1774188194099
        }
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def normalize_image(img):\n",
        "    \"\"\"Normalize pixel values to 0-1 range.\"\"\"\n",
        "    arr = np.array(img).astype(np.float32)\n",
        "    arr_min, arr_max = arr.min(), arr.max()\n",
        "    if arr_max - arr_min > 0:\n",
        "        arr = (arr - arr_min) / (arr_max - arr_min)\n",
        "    return arr\n",
        "\n",
        "def run_etl(raw_client, proc_client, max_images=None):\n",
        "    \"\"\"\n",
        "    Main ETL pipeline:\n",
        "    1. Download from raw container\n",
        "    2. Validate each image\n",
        "    3. Normalize pixel values\n",
        "    4. Upload clean images to processed container\n",
        "    5. Return validation report\n",
        "    \"\"\"\n",
        "    blobs = list(raw_client.list_blobs())\n",
        "    if max_images:\n",
        "        blobs = blobs[:max_images]\n",
        "    \n",
        "    print(f\"Processing {len(blobs)} images...\")\n",
        "    report = []\n",
        "\n",
        "    for blob in tqdm(blobs):\n",
        "        try:\n",
        "            # Download\n",
        "            data = raw_client.download_blob(blob.name).readall()\n",
        "            img = Image.open(BytesIO(data)).convert(\"L\")  # grayscale\n",
        "            \n",
        "            # Validate\n",
        "            stats = validate_image(img, blob.name)\n",
        "            report.append(stats)\n",
        "\n",
        "            # Skip invalid\n",
        "            if not stats[\"valid\"]:\n",
        "                continue\n",
        "\n",
        "            # Normalize\n",
        "            arr_norm = normalize_image(img)\n",
        "            \n",
        "            # Convert back to PNG for upload\n",
        "            img_norm = Image.fromarray((arr_norm * 255).astype(np.uint8))\n",
        "            buf = BytesIO()\n",
        "            img_norm.save(buf, format=\"PNG\")\n",
        "            buf.seek(0)\n",
        "\n",
        "            # Upload to processed container\n",
        "            clean_name = blob.name.replace(\"magnetograms/\", \"clean/\")\n",
        "            proc_client.upload_blob(name=clean_name, data=buf, overwrite=True)\n",
        "\n",
        "        except Exception as e:\n",
        "            print(f\"Error processing {blob.name}: {e}\")\n",
        "            continue\n",
        "\n",
        "    return pd.DataFrame(report)\n",
        "\n",
        "print(\"ETL function ready!\")"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "ETL function ready!\n"
        }
      ],
      "execution_count": 4,
      "metadata": {
        "gather": {
          "logged": 1774188194191
        }
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Run ETL pipeline\n",
        "# Note: will process 0 images until Maymona uploads the dataset\n",
        "report_df = run_etl(raw_client, proc_client)\n",
        "\n",
        "if len(report_df) > 0:\n",
        "    # Save validation report\n",
        "    os.makedirs(\"outputs\", exist_ok=True)\n",
        "    report_df.to_csv(\"outputs/validation_report.csv\", index=False)\n",
        "    \n",
        "    print(f\"\\nETL Summary:\")\n",
        "    print(f\"Total images processed: {len(report_df)}\")\n",
        "    print(f\"Valid images:           {report_df['valid'].sum()}\")\n",
        "    print(f\"Invalid/blank images:   {(~report_df['valid']).sum()}\")\n",
        "    print(f\"Label distribution:\\n{report_df['label'].value_counts()}\")\n",
        "else:\n",
        "    print(\"No images found in raw container yet — ETL ready to run once data is uploaded!\")"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stderr",
          "text": "\n"
        }
      ],
      "execution_count": 5,
