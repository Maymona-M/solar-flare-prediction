{
  "cells": [
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from PIL import Image\n",
        "from io import BytesIO\n",
        "from azure.storage.blob import BlobServiceClient\n",
        "from tqdm import tqdm\n",
        "import random\n",
        "\n",
        "# Config\n",
        "STORAGE_ACCOUNT = \"solarflarestorageproject\"\n",
        "STORAGE_KEY = \"os.environ.get("AZURE_STORAGE_KEY")\"\n",
        "RAW_CONTAINER = \"raw\"\n",
        "\n",
        "print(\"Libraries loaded!\")"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "Libraries loaded!\n"
        }
      ],
      "execution_count": 1,
      "metadata": {
        "gather": {
          "logged": 1774188341323
        }
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Connect to storage\n",
        "container_client = BlobServiceClient(\n",
        "    account_url=f\"https://{STORAGE_ACCOUNT}.blob.core.windows.net\",\n",
        "    credential=STORAGE_KEY\n",
        ").get_container_client(RAW_CONTAINER)\n",
        "\n",
        "blobs = list(container_client.list_blobs())\n",
        "print(f\"Connected! Found {len(blobs)} blobs in raw container.\")\n",
        "\n",
        "# Build dataframe of all blob names\n",
        "df = pd.DataFrame({\"blob_name\": [b.name for b in blobs]})\n",
        "print(df.head())"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "Connected! Found 0 blobs in raw container.\nEmpty DataFrame\nColumns: [blob_name]\nIndex: []\n"
        }
      ],
      "execution_count": 2,
      "metadata": {
        "gather": {
          "logged": 1774188396569
        }
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def parse_label(blob_name):\n",
        "    \"\"\"Extract flare class from filename.\"\"\"\n",
        "    filename = blob_name.split(\"/\")[-1]\n",
        "    for cls in [\"X\", \"M\", \"C\", \"B\"]:\n",
        "        if filename.startswith(cls):\n",
        "            return cls\n",
        "    return \"N\"  # no flare\n",
        "\n",
        "def parse_binary_label(label):\n",
        "    \"\"\"Binary: flare (M or X) vs no flare (B, C, N)\"\"\"\n",
        "    return 1 if label in [\"M\", \"X\"] else 0\n",
        "\n",
        "if len(df) > 0:\n",
        "    df[\"label\"] = df[\"blob_name\"].apply(parse_label)\n",
        "    df[\"binary_label\"] = df[\"label\"].apply(parse_binary_label)\n",
        "    \n",
        "    print(\"Class distribution (multi-class):\")\n",
        "    print(df[\"label\"].value_counts())\n",
        "    print(f\"\\nClass distribution (binary):\")\n",
        "    print(df[\"binary_label\"].value_counts())\n",
        "    print(f\"\\nFlare rate: {df['binary_label'].mean():.2%}\")\n",
        "else:\n",
        "    print(\"No data yet — will show class balance once dataset is uploaded.\")"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "No data yet — will show class balance once dataset is uploaded.\n"
        }
      ],
      "execution_count": 3,
      "metadata": {
        "gather": {
          "logged": 1774189738223
        }
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def sample_and_analyze(container_client, df, n_samples=100):\n",
        "    \"\"\"Sample n images and compute pixel statistics.\"\"\"\n",
        "    if len(df) == 0:\n",
        "        print(\"No data yet.\")\n",
        "        return None\n",
        "    \n",
        "    sample = df.sample(min(n_samples, len(df)))\n",
        "    stats = []\n",
        "\n",
        "    for _, row in tqdm(sample.iterrows(), total=len(sample)):\n",
        "        try:\n",
        "            data = container_client.download_blob(row[\"blob_name\"]).readall()\n",
        "            img = Image.open(BytesIO(data)).convert(\"L\")\n",
        "            arr = np.array(img).astype(np.float32)\n",
        "            stats.append({\n",
        "                \"blob_name\":  row[\"blob_name\"],\n",
        "                \"label\":      row[\"label\"],\n",
        "                \"mean_pixel\": arr.mean(),\n",
        "                \"std_pixel\":  arr.std(),\n",
        "                \"min_pixel\":  arr.min(),\n",
        "                \"max_pixel\":  arr.max(),\n",
        "            })\n",
        "        except Exception as e:\n",
        "            print(f\"Error: {e}\")\n",
        "            continue\n",
        "\n",
        "    return pd.DataFrame(stats)\n",
        "\n",
        "if len(df) > 0:\n",
        "    stats_df = sample_and_analyze(container_client, df)\n",
        "    print(stats_df.describe())\n",
        "else:\n",
        "    print(\"No data yet — pixel analysis will run once dataset is uploaded.\")"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "No data yet — pixel analysis will run once dataset is uploaded.\n"
        }
      ],
      "execution_count": 4,
      "metadata": {
        "gather": {
          "logged": 1774189762478
        }
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def plot_eda(df, stats_df):\n",
        "    \"\"\"Generate EDA plots.\"\"\"\n",
        "    fig, axes = plt.subplots(2, 2, figsize=(14, 10))\n",
        "    fig.suptitle(\"Solar Flare Magnetogram EDA\", fontsize=16)\n",
        "\n",
        "    # Plot 1: Class balance (multi-class)\n",
        "    df[\"label\"].value_counts().plot(kind=\"bar\", ax=axes[0, 0], color=\"steelblue\")\n",
        "    axes[0, 0].set_title(\"Class Distribution (Multi-class)\")\n",
        "    axes[0, 0].set_xlabel(\"Flare Class\")\n",
        "    axes[0, 0].set_ylabel(\"Count\")\n",
        "\n",
        "    # Plot 2: Binary class balance\n",
        "    df[\"binary_label\"].value_counts().plot(kind=\"bar\", ax=axes[0, 1], color=[\"salmon\", \"steelblue\"])\n",
        "    axes[0, 1].set_title(\"Class Distribution (Binary)\")\n",
        "    axes[0, 1].set_xticklabels([\"No Flare\", \"Flare\"], rotation=0)\n",
        "    axes[0, 1].set_ylabel(\"Count\")\n",
        "\n",
        "    # Plot 3: Mean pixel intensity by class\n",
        "    sns.boxplot(data=stats_df, x=\"label\", y=\"mean_pixel\", ax=axes[1, 0])\n",
        "    axes[1, 0].set_title(\"Mean Pixel Intensity by Class\")\n",
        "    axes[1, 0].set_xlabel(\"Flare Class\")\n",
        "    axes[1, 0].set_ylabel(\"Mean Pixel Value\")\n",
        "\n",
        "    # Plot 4: Pixel std by class\n",
        "    sns.boxplot(data=stats_df, x=\"label\", y=\"std_pixel\", ax=axes[1, 1])\n",
        "    axes[1, 1].set_title(\"Pixel Std Dev by Class\")\n",
        "    axes[1, 1].set_xlabel(\"Flare Class\")\n",
        "    axes[1, 1].set_ylabel(\"Std Dev\")\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(\"outputs/eda_plots.png\", dpi=150)\n",
        "    plt.show()\n",
        "    print(\"Plots saved to outputs/eda_plots.png\")\n",
        "\n",
        "if len(df) > 0:\n",
        "    import os\n",
        "    os.makedirs(\"outputs\", exist_ok=True)\n",
        "    plot_eda(df, stats_df)\n",
        "else:\n",
        "    print(\"No data yet — plots will generate once dataset is uploaded.\")"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "No data yet — plots will generate once dataset is uploaded.\n"
        }
      ],
      "execution_count": 5,
      "metadata": {
        "gather": {
          "logged": 1774189974021
        }
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def show_sample_images(container_client, df, n=8):\n",
        "    \"\"\"Display a grid of sample images with their labels.\"\"\"\n",
        "    if len(df) == 0:\n",
        "        print(\"No data yet — sample images will show once dataset is uploaded.\")\n",
        "        return\n",
        "    \n",
        "    sample = df.sample(min(n, len(df)))\n",
        "    fig, axes = plt.subplots(2, 4, figsize=(16, 8))\n",
        "    fig.suptitle(\"Sample Magnetogram Images by Class\", fontsize=14)\n",
        "    axes = axes.flatten()\n",
        "\n",
        "    for i, (_, row) in enumerate(sample.iterrows()):\n",
        "        try:\n",
        "            data = container_client.download_blob(row[\"blob_name\"]).readall()\n",
        "            img = Image.open(BytesIO(data)).convert(\"L\")\n",
        "            axes[i].imshow(img, cmap=\"gray\")\n",
        "            axes[i].set_title(f\"Class: {row['label']}\")\n",
        "            axes[i].axis(\"off\")\n",
        "        except Exception as e:\n",
        "            axes[i].set_title(\"Error\")\n",
        "            axes[i].axis(\"off\")\n",
        "\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(\"outputs/sample_images.png\", dpi=150)\n",
        "    plt.show()\n",
        "    print(\"Sample images saved to outputs/sample_images.png\")\n",
        "\n",
        "show_sample_images(container_client, df)"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "No data yet — sample images will show once dataset is uploaded.\n"
        }
      ],
      "execution_count": 6,
      "metadata": {
        "gather": {
          "logged": 1774190006219
        }
      }
